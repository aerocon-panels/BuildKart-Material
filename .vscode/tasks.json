{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run BuildKart API integration verification",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"backend\\BuildKart.API",
				"--no-launch-profile",
				"--urls",
				"http://localhost:5000"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run BuildKart API in Development",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"set ASPNETCORE_ENVIRONMENT=Development&&dotnet run --project backend\\BuildKart.API --no-launch-profile --urls http://localhost:5001"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Test BuildKart API endpoints",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				".integration-check\\IntegrationCheck.csproj"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run BuildKart frontend integration",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"localhost"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Recheck BuildKart API routes",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				".integration-check\\IntegrationCheck.csproj"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Build API and frontend integration",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dotnet build backend\\BuildKart.API\\BuildKart.API.csproj && npm run build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Verify BuildKart frontend server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"localhost",
				"--port",
				"5173",
				"--strictPort"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}